# ── .hermes coordination layer: track the project's memory (text receipts/boards/plans),
#    not the data lake (media, caches, datasets, vendored deps stay on disk, receipt-pinned)
.hermes/**
!.hermes/**/
!.hermes/**/*.md
!.hermes/**/*.json
!.hermes/**/*.txt
!.hermes/**/*.html
!.hermes/**/*.yaml
!.hermes/**/*.yml
# re-excluded even though text-typed:
.hermes/**/fulltext_cache/**
.hermes/**/build-stage/**
.hermes/**/.deps/**
.hermes/**/_tmp_*
.hermes/logs/**
.hermes/tmp/**
.hermes/backups/**
