          "contract_max_tier": "mixed_debated",
          "template_actual_tier": "mixed_debated",
          "certainty_level": "actively_debated"
        }
      ]
    },
    {
      "sentence_id": "s7_C02",
      "text": "Strangulation, environmental stripping, and cold-gas pathway differences remain mandatory alternative or qualifying quenching channels.",
      "bound_entry_ids": [
        "clc_agn_007_alternative_quenching_channels"
      ],
      "max_allowed_tier": "commonly_probably",
      "actual_tier": "commonly_probably",
