          "contract_max_tier": "commonly_probably",
          "template_actual_tier": "commonly_probably",
          "certainty_level": "widely_supported"
        }
      ]
    },
    {
      "sentence_id": "s7_C04",
      "text": "Central properties — bulge mass, central velocity dispersion, or black-hole mass — are a real quenching-predictor axis; the black-hole-mass machine-learning result joins this position only as a qualifier, because it is simulation-comparison-based.",
      "bound_entry_ids": [
        "clc_agn_009_central_bh_bulge_predictor_axis"
      ],
      "max_allowed_tier": "commonly_probably",
      "actual_tier": "commonly_probably",
      "certainty_level": "widely_supported",
      "epistemic_type": "observational_sample",
      "source_access": "full_text",
      "passes": true,
