          "certainty_level": "widely_supported"
        }
      ]
    },
    {
      "sentence_id": "s7_C05",
      "text": "Halo, environment, and satellite-quenching channels are also real quenching axes and must remain separate from central/BH predictors.",
      "bound_entry_ids": [
        "clc_agn_010_halo_environment_satellite_axis"
      ],
      "max_allowed_tier": "commonly_probably",
      "actual_tier": "commonly_probably",
      "certainty_level": "widely_supported",
      "epistemic_type": "observational_sample",
      "source_access": "full_text",
