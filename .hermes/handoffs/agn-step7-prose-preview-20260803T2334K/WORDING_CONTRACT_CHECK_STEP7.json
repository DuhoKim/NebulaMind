          "contract_max_tier": "commonly_probably",
          "template_actual_tier": "commonly_probably",
          "certainty_level": "widely_supported"
        }
      ]
    },
    {
      "sentence_id": "s7_C03",
      "text": "Behind that position: strangulation appears primary for local galaxies below 10^11 solar masses on a roughly 4 Gyr timescale, stripping is reported as ubiquitous among satellites, and central galaxies defy simple pathway assignments.",
      "bound_entry_ids": [
        "clc_agn_007_alternative_quenching_channels"
      ],
      "max_allowed_tier": "commonly_probably",
      "actual_tier": "commonly_probably",
      "certainty_level": "widely_supported",
      "epistemic_type": "review",
