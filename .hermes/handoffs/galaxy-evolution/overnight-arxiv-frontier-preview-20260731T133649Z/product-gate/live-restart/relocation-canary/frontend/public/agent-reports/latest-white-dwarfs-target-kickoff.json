  "db_snapshot_summary": {
    "checked_at_utc": "2026-07-04T07:04:36Z",
    "galaxy_page": {
      "content_sha256": "e07af50d6e44bec53b75869a4d93dc230d9dd2129a3854ce3eb3f5b4ec52203f",
      "id": 57,
      "slug": "galaxy-evolution"
    },
    "target_claim_count": 17,
    "target_claim_trust_counts": [
      {
        "claim_count": 8,
        "trust_level": "accepted"
      },
      {
