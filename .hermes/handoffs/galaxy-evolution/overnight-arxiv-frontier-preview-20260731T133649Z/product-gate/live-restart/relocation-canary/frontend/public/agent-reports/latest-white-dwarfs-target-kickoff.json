      }
    ],
    "target_claims": [
      {
        "id": 1006,
        "order_idx": 0,
        "section": "Discovery & History",
        "text": "The existence of white dwarfs was first proposed by Sir Arthur Eddington in 1924, who suggested that stars could undergo a transformation into a hot, compact remnant.",
        "trust_level": "accepted",
        "trust_score": 0.4499999999999999
      },
      {
        "id": 1007,
        "order_idx": 1,
        "section": "Discovery & History",
        "text": "However, it wasn't until the 1930s that the existence of white dwarfs was observationally confirmed by the Dutch astronomer Willem Luyten.",
        "trust_level": "accepted",
        "trust_score": 0.6712421946079271
      },
      {
        "id": 1008,
        "order_idx": 2,
        "section": "Physical Properties",
        "text": "Building on this discovery, subsequent observations showed that white dwarfs are extremely small, with radii typically ranging from 0.01 to 0.1 solar radii.",
        "trust_level": "accepted",
        "trust_score": 0.5141698898064646
      },
      {
        "id": 1009,
        "order_idx": 3,
        "section": "Physical Properties",
        "text": "Furthermore, white dwarfs have masses typically ranging from 0.5 to 1.2 solar masses.",
        "trust_level": "consensus",
        "trust_score": 0.42982887133134196
      },
      {
        "id": 1010,
        "order_idx": 4,
        "section": "Physical Properties",
        "text": "Subsequently, research revealed that white dwarfs are much less luminous than main-sequence stars, with luminosities ranging from 10^-4 to 10 L.",
        "trust_level": "debated",
        "trust_score": 0.2986463080436639
      },
      {
        "id": 1011,
        "order_idx": 5,
        "section": "Current Research",
        "text": "As a result of these discoveries, a new generation of white dwarf research has focused on understanding the atmospheric properties of these stars.",
        "trust_level": "accepted",
        "trust_score": 0.7872727270938894
      },
      {
        "id": 1012,
        "order_idx": 6,
        "section": "Open Questions",
        "text": "However, despite significant advances in our understanding of white dwarfs, the exact mechanisms governing white dwarf cooling remain poorly understood.",
        "trust_level": "accepted",
        "trust_score": 0.6827549578254442
      },
      {
        "id": 1013,
        "order_idx": 7,
        "section": "Open Questions",
        "text": "This discovery revealed that a critical component of white dwarf cooling is the ionization state of hydrogen in their atmospheres.",
        "trust_level": "accepted",
        "trust_score": 0.47558606264054576
      },
      {
        "id": 1014,
        "order_idx": 8,
        "section": "Open Questions",
        "text": "Recent observations show that the magnetic fields of several white dwarf stars are highly variable, potentially influencing their atmospheric properties.",
        "trust_level": "debated",
        "trust_score": 0.17809555605194544
      },
      {
        "id": 1015,
        "order_idx": 9,
        "section": "Open Questions",
        "text": "Furthermore, a deeper understanding of white dwarf magnetic fields is crucial for accurately modeling the expected white dwarf luminosity functions.",
        "trust_level": "accepted",
        "trust_score": 0.7456987337028127
      },
      {
        "id": 1016,
        "order_idx": 10,
        "section": "Open Questions",
        "text": "This understanding is critical for addressing open questions, such as the role of white dwarfs in the overall evolution of star clusters.",
        "trust_level": "accepted",
        "trust_score": 0.7561472118724987
      },
      {
        "id": 1273,
        "order_idx": 1000,
        "section": "Open Debates",
        "text": "The mass distribution of white dwarfs is primarily influenced by single-star evolution.",
        "trust_level": "debated",
        "trust_score": 0.37415521157684545
      },
      {
        "id": 1274,
        "order_idx": 1001,
        "section": "Open Debates",
        "text": "The mass distribution of white dwarfs is significantly affected by binary interactions and mergers.",
        "trust_level": "debated",
        "trust_score": 0.6712421955899952
      },
      {
        "id": 1275,
        "order_idx": 1010,
        "section": "Open Debates",
        "text": "White dwarf cooling rates are primarily determined by plasma neutrino losses and axion emission.",
        "trust_level": "debated",
        "trust_score": 0.12237475142234594
      },
      {
        "id": 1276,
        "order_idx": 1011,
        "section": "Open Debates",
        "text": "Crystallization and phase separation are more significant factors in determining white dwarf cooling rates than previously thought.",
        "trust_level": "debated",
        "trust_score": 0.7864290272588972
      },
      {
        "id": 1277,
        "order_idx": 1020,
        "section": "Open Debates",
        "text": "Strong magnetic fields in white dwarfs are primarily the result of a dynamo mechanism during their main-sequence progenitor phase.",
        "trust_level": "debated",
        "trust_score": 0.3122857308994217
      },
      {
        "id": 1278,
        "order_idx": 1021,
        "section": "Open Debates",
        "text": "The majority of white dwarf magnetic fields are more likely the result of binary mergers and interactions.",
        "trust_level": "debated",
        "trust_score": 0.44999999999986023
      }
    ],
