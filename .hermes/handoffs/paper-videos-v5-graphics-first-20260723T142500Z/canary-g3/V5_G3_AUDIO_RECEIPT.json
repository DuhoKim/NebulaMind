      "actual_speech_end_seconds": 13.392001
    },
    {
      "cut_index": 4,
      "storyboard_row": 15,
      "text": "Now the five unlensed galaxies appear — the red circles.",
      "text_sha256": "e8a244ec1f7b07238eae484b5503b14f9fe72b741cac597e78a37852cd310cd1",
      "words": 9,
