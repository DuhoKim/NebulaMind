      "audio_sha256": "3cb007d1c2347d8e5a86d40ac02cce723288891d11e2db26e3d1f6aec4489042",
      "speech_duration_seconds": 3.754667,
      "actual_start_seconds": 14.392001,
      "actual_speech_end_seconds": 18.146668
    },
    {
      "cut_index": 5,
      "storyboard_row": 16,
      "text": "Every one sits below the benchmark, near one fifth of the nearby level.",
