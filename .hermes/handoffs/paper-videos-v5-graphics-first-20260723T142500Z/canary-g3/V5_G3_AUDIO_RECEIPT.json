      "speech_duration_seconds": 2.666667,
      "actual_start_seconds": 0.0,
      "actual_speech_end_seconds": 2.666667
    },
    {
      "cut_index": 2,
      "storyboard_row": 13,
      "text": "Across runs each galaxy's stellar mass, and up runs its gas oxygen abundance.",
