      "audio_sha256": "303acb9806e22f300129129dc4658dfd5675a448760eec31c1bdb2ac039a32eb",
      "speech_duration_seconds": 5.674667,
      "actual_start_seconds": 3.666667,
      "actual_speech_end_seconds": 9.341334
    },
    {
      "cut_index": 3,
      "storyboard_row": 14,
      "text": "These curves show the nearby benchmark relations.",
