      "audio_sha256": "30147ed7e0e91141c6a49d91d9384d262e78a08a003ed269dc9c4a00d482d44e",
      "speech_duration_seconds": 6.592,
      "actual_start_seconds": 24.776001,
      "actual_speech_end_seconds": 31.368001
    },
    {
      "cut_index": 7,
      "storyboard_row": 18,
      "text": "What if the benchmark itself misleads — swap it for one measured at exactly these masses.",
