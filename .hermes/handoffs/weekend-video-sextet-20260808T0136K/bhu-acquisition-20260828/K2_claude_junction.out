K2 junction classification -- Claude seat.  sympy 1.14.0

== exterior SdS extrinsic curvature (surface (T(s),R(s)), n_mu = (-Rdot, Tdot, 0, 0)) ==
  K^theta_theta+ = Tdot*(-Lambda*R_b**3 - 6*M + 3*R_b)/(3*R_b**2)
  K^s_s+ (Tddot eliminated by the first-fundamental-form constraint) = (9*R_b**2*Rdot**2*(Lambda*R_b**3*Tdot**2*(Lambda*R_b**3 + 6*M - 3*R_b)**3 - 3*M*Tdot**2*(Lambda*R_b**3 + 6*M - 3*R_b)**3 - 9*R_b**3*Rddot*(Lambda*R_b**3 + 6*M - 3*R_b)**2 + 9*R_b**2*Rdot**2*(Lambda**2*R_b**6 + 3*Lambda*M*R_b**3 - 3*Lambda*R_b**4 - 18*M**2 + 9*M*R_b) + 2*Tdot**2*(-Lambda*R_b**3 + 3*M)*(Lambda*R_b**3 + 6*M - 3*R_b)**3) + Tdot**2*(Lambda*R_b**3 + 6*M - 3*R_b)**3*(9*R_b**3*Rddot*(Lambda*R_b**3 + 6*M - 3*R_b) + 9*R_b**2*Rdot**2*(-Lambda*R_b**3 + 3*M) + Tdot**2*(Lambda*R_b**3 - 3*M)*(Lambda*R_b**3 + 6*M - 3*R_b)**2))/(9*R_b**3*Tdot*(Lambda*R_b**3 + 6*M - 3*R_b)**4)
  check  K^s_s+ * (F Tdot) - (Rddot + F'/2) on the constraint surface = 0
  beta_+ := F Tdot,  beta_+^2 = F + Rdot^2  [constraint]

== interior FRW k=1, surface chi = X(t) (general B3; B1 is Xdot=0) ==
  K^theta_theta- = (Xdot*a*adot + 1/tan(X))/(a*sqrt(-Xdot**2*a**2 + 1))
  K^s_s-         = (Xddot*a - Xdot**3*a**2*adot + 2*Xdot*adot)/(-Xdot**2*a**2 + 1)**(3/2)
  beta_- = n.dR  = (Xdot*a*adot*sin(X) + cos(X))/sqrt(-Xdot**2*a**2 + 1)
  u.n (dust 4-velocity dotted with the unit normal) = -Xdot*a/sqrt(-Xdot**2*a**2 + 1)

== interior FRW k=0, surface chi = X(t) (general B3; B1 is Xdot=0) ==
  K^theta_theta- = (X*Xdot*a*adot + 1)/(X*a*sqrt(-Xdot**2*a**2 + 1))
  K^s_s-         = (Xddot*a - Xdot**3*a**2*adot + 2*Xdot*adot)/(-Xdot**2*a**2 + 1)**(3/2)
  beta_- = n.dR  = (X*Xdot*a*adot + 1)/sqrt(-Xdot**2*a**2 + 1)
  u.n (dust 4-velocity dotted with the unit normal) = -Xdot*a/sqrt(-Xdot**2*a**2 + 1)

