from pathlib import Path
from bs4 import BeautifulSoup
import hashlib
source=Path('bounce/b4_springer_access.html')
soup=BeautifulSoup(source.read_text(),'html.parser')

def equation_quote(number):
    e=soup.find(id=f'Equ{number}')
    math=e.select_one('.mathjax-tex').get_text()
    label=e.select_one('.c-article-equation__number').get_text(strip=True)
    return (f'**Verbatim quotation — publisher HTML, Eq. ({number}), "'`Equ{number}`; read directly, not arXiv:**'"\\n\\n'
            f'> {math}\\n>\\n> {label}\\n')

def prose_quote(number,side):
    e=soup.find(id=f'Equ{number}')
    p=e.find_previous_sibling() if side=='before' else e.find_next_sibling()
    return (f'**Verbatim quotation — publisher HTML, immediately {side} Eq. ({number}); read directly, not arXiv:**\\n\\n'
            f'> {p.get_text()}\\n')

