+def rhs(closure, a, b):
+    def f(t, y):
+        lx, ly, u, v, n, e, H, D, K, V = physical(y, closure)
+        P = e/3-a*n*n
+        psi = b*H**4
+        ed = 2*a*n*psi-4*H*e
