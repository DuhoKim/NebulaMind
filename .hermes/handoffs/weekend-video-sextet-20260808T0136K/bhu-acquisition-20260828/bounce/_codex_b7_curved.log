+    flow = (fu, fv, -2*v*K, fe, fn)
+
+    def dot(q):
+        return sum(sp.diff(q, x)*f for x, f in zip(state, flow))
+
+    def zero(label, q):
+        r = sp.factor(q)
+        print(label + "=" + str(r))
+        assert r == 0, (label, r)
+
+    # Verify the actual spatial-equation extension, including off C=0.
+    for closure in ("b", "c"):
+        if closure == "b":
+            et = hs*T**4
+            td = (2*a*n*psi-4*H*et)/(4*hs*T**3)
