+Tc = s.solve(log_slope, T)[0]
+zero("DIRAC_EQ16", Tc-s.sqrt(2*hs/(3*alpha_D*hn**2)))
+zero("DIRAC_CUSP_DADT", s.diff(a_D, T).subs(T, Tc))
