(version 1)
(deny default)
(allow process*)
(allow signal)
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix*)
(allow network*)
(allow file-read-metadata)
(allow file-ioctl)
(allow file-read* (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/System") (subpath "/Library") (subpath "/private/etc") (subpath "/dev") (subpath "/private/var/folders") (subpath "/private/tmp") (subpath "/var/folders") (subpath "/Users/duhokim/.local") (subpath "/Users/duhokim/.codex") (subpath "/Users/duhokim/.nvm") (subpath "/Users/duhokim/.hermes") (subpath "/opt/homebrew") (literal "/Users/duhokim") (literal "/Users") (literal "/"))
(allow file-read* (subpath (param "WORKDIR")))
(allow file-write* (subpath (param "WORKDIR")) (subpath "/private/var/folders") (subpath "/private/tmp") (subpath "/dev") (subpath "/Users/duhokim/.codex") (subpath "/Users/duhokim/.hermes"))
