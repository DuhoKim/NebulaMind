      "decoded_file_sha256": "128ad9af3a58c6e0a2f67f4d63e8ed2b4457228bfe204483365e8dc72db91d44",
      "audio_start_sample": 5747724,
      "audio_end_sample": 6208524,
      "audio_start_seconds": 119.74425,
      "audio_end_seconds": 129.34425,
      "visual_action_start_frame": 3592,
      "visual_action_start_seconds": 119.73333333333333,
      "alignment_delta_seconds": -0.01091666666665958,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75
    },
    {
      "id": "s21",
      "section": "boundary",
      "text": "Known now are the sample, estimator, mirror logic, and controls; no result value, direction, or interpretation is reportable.",
      "word_count": 18,
      "raw_file": "audio_v2/raw/s21-7356873d828a.mp3",
