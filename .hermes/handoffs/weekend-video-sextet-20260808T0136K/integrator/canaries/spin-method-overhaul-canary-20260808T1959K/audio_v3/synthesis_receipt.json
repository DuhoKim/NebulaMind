            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "5.184000",
          "size": "82944"
        }
      }
    },
    {
      "id": "s10",
      "section": "mirror-climax",
      "text": "One mirror, two incompatible predicted behaviors: that difference is the scientific discriminant.",
      "text_sha256": "3b19d3104719b6e7bdb6b60b6b493507c71e449b6bec1d59d93b8ba4ac9d50fc",
      "file": "audio_v3/raw/s10-3b19d3104719.mp3",
