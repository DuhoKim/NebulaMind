      "probe": {
        "programs": [],
        "stream_groups": [],
        "streams": [
          {
            "codec_name": "mp3",
            "codec_type": "audio",
            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "4.200000",
          "size": "67200"
        }
      }
    },
    {
      "id": "s09",
      "section": "mirror-climax",
      "text": "If it entered through the labeling process instead, it need not follow the pixels.",
      "text_sha256": "0de62cff2934285852f8fcd2fed708bb361076c30f7baac5726582fa26fe0bb3",
      "file": "audio_v3/raw/s09-0de62cff2934.mp3",
      "file_sha256": "99c9d3c1a4772ae851931b12ac377cd7786d1deb0173e69721c53ab7e138fa74",
      "probe": {
        "programs": [],
        "stream_groups": [],
        "streams": [
          {
            "codec_name": "mp3",
