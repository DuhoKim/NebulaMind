            "codec_type": "audio",
            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "4.752000",
          "size": "76032"
        }
      }
    },
    {
      "id": "i03",
      "section": "motivation",
      "text": "But humans sorted the images, so an apparent excess could instead be a fact about the sorters.",
      "text_sha256": "d14fd6ddee00287c65205d98866a5c7a61bc48eb05659952d7a628c5121aae0e",
      "file": "audio_v3/raw/i03-d14fd6ddee00.mp3",
