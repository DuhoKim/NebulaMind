    },
    {
      "id": "i02",
      "section": "motivation",
      "text": "If one were genuinely more common across the sky, that would be a fact about the universe.",
      "text_sha256": "bb7060d2c472d20ef31780a8cbcc58a0951d6978265df4302883627440067f64",
      "file": "audio_v3/raw/i02-bb7060d2c472.mp3",
