          {
            "codec_name": "mp3",
            "codec_type": "audio",
            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "5.664000",
          "size": "90624"
        }
      }
    },
    {
      "id": "i04",
      "section": "motivation",
      "text": "How do we tell the two apart?",
      "text_sha256": "1c9b5c18fd951550e7e5846b3a63e4f650d5ab666967b276891ab8d799e1493f",
      "file": "audio_v3/raw/i04-1c9b5c18fd95.mp3",
      "file_sha256": "462204f5fa317804a3c445d9670e458804bd484b0193a4d6a8afcc6e8e7df85d",
      "probe": {
        "programs": [],
        "stream_groups": [],
        "streams": [
          {
            "codec_name": "mp3",
            "codec_type": "audio",
            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "2.136000",
          "size": "34176"
        }
      }
    },
    {
      "id": "s02",
      "section": "question",
      "text": "Can an apparent imbalance between clockwise and anticlockwise labels be separated from one introduced by the labeling process?",
      "text_sha256": "ee829c9ef24e6e96ca3b73040a8e3ac6b351571b05f9b38d478e4721891c965a",
      "file": "audio_v3/raw/s02-ee829c9ef24e.mp3",
      "file_sha256": "e2b59324949b0472a4d727fdfdc28602f4609cee7fcf739e5d098a48969df74b",
      "probe": {
        "programs": [],
        "stream_groups": [],
        "streams": [
          {
            "codec_name": "mp3",
            "codec_type": "audio",
            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "6.024000",
          "size": "96384"
        }
      }
    },
    {
      "id": "s03",
      "section": "two-worlds",
      "text": "Two explanations can create the same apparent imbalance.",
      "text_sha256": "2654139c78f30dc6ac52754426d248e515600d47aef72f39a0818f5a076abd7f",
      "file": "audio_v3/raw/s03-2654139c78f3.mp3",
      "file_sha256": "2794f04f63545e44e7cd0c261ac2a18e7750f380563f59675ea67798853e5421",
      "probe": {
        "programs": [],
        "stream_groups": [],
        "streams": [
          {
            "codec_name": "mp3",
            "codec_type": "audio",
            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "3.408000",
          "size": "54528"
        }
      }
    },
    {
      "id": "s04",
      "section": "two-worlds",
      "text": "One places the pattern in the images.",
      "text_sha256": "c2f6b0727d046ad77d44d24a9ddd2910ba3fefd3f8dd3b7e4762a1be656bf511",
      "file": "audio_v3/raw/s04-c2f6b0727d04.mp3",
      "file_sha256": "15d8873bf6de434632e25e40ccde5accb6766f65e1ff7bb88f91fa98706c2b4a",
      "probe": {
        "programs": [],
        "stream_groups": [],
        "streams": [
          {
            "codec_name": "mp3",
            "codec_type": "audio",
            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "2.424000",
          "size": "38784"
        }
      }
    },
    {
      "id": "s05",
      "section": "two-worlds",
      "text": "The other places it in the labeling process.",
      "text_sha256": "798294462935195091a0236873990264bc76d6ada3a22ec1db5760690056f6a2",
      "file": "audio_v3/raw/s05-798294462935.mp3",
