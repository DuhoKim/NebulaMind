      "probe": {
        "programs": [],
        "stream_groups": [],
        "streams": [
          {
            "codec_name": "mp3",
            "codec_type": "audio",
            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "3.648000",
          "size": "58368"
        }
      }
    },
    {
      "id": "s06",
      "section": "mirror-climax",
      "text": "Apply one decisive test to both worlds: mirror the same conceptual spiral horizontally.",
      "text_sha256": "ddb7198d69648c42be73567bf013379d08242dec8f7969258c638002b787455d",
      "file": "audio_v3/raw/s06-ddb7198d6964.mp3",
      "file_sha256": "a36fcdf270fe3916f2c2e205b33ccd2100f3c6053aae8bc328e90978f4ad870c",
      "probe": {
        "programs": [],
        "stream_groups": [],
        "streams": [
          {
            "codec_name": "mp3",
            "codec_type": "audio",
            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "5.280000",
          "size": "84480"
        }
      }
    },
    {
      "id": "s07",
      "section": "mirror-climax",
      "text": "The geometry reverses, and its apparent label inverts from clockwise to anticlockwise.",
      "text_sha256": "4ec7573b3247d00d4b3357c7f77185bcb3383f2e0fe9cfb3049d17e2849ea0c2",
      "file": "audio_v3/raw/s07-4ec7573b3247.mp3",
      "file_sha256": "a48b0bce294c06c3124fd19346cee1ad99351889e0f78ab25d2ce833e8d4d83e",
      "probe": {
        "programs": [],
        "stream_groups": [],
        "streams": [
          {
            "codec_name": "mp3",
            "codec_type": "audio",
            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "4.968000",
          "size": "79488"
        }
      }
    },
    {
      "id": "s08",
      "section": "mirror-climax",
      "text": "If the pattern belongs to the images themselves, it must follow that inversion.",
      "text_sha256": "b7adc8ea224c55c5483515e22ec16c72bfcb8b2bb6e11275866f71b3e58d1be0",
      "file": "audio_v3/raw/s08-b7adc8ea224c.mp3",
