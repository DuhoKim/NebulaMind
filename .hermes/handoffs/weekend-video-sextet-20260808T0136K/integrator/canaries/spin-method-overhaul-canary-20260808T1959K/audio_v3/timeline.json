      "visual_action_start_seconds": 116.6,
      "alignment_delta_seconds": 0.0015416666666538958,
      "pause_after_samples": 177075,
      "pause_after_seconds": 3.6890625
    },
    {
      "id": "s17",
      "section": "controls",
      "text": "The control matrix joins the mirror, both thresholds, and same-object pairs.",
      "word_count": 11,
      "raw_file": "audio_v3/raw/s17-3d9085cd8f35.mp3",
