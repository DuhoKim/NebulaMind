  "records": [
    {
      "id": "i01",
      "section": "motivation",
      "text": "Spirals come in two handednesses.",
      "word_count": 5,
      "raw_file": "audio_v3/raw/i01-444816d3417a.mp3",
      "raw_file_sha256": "b622ecc7a1c0e98e9400097554bf6fe97fa6a6bfadbb6dc893bc41cc731f8a6d",
      "decoded_file": "audio_v3/decoded/i01.wav",
      "decoded_file_sha256": "00c034aee8cba79a4ad96734b37a45a06abd979cc818c3b72a77dd29c9ec5954",
      "audio_start_sample": 28800,
      "audio_end_sample": 152064,
      "audio_start_seconds": 0.6,
      "audio_end_seconds": 3.168,
      "visual_action_start_frame": 18,
      "visual_action_start_seconds": 0.6,
      "alignment_delta_seconds": 0.0,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75
    },
    {
      "id": "i02",
      "section": "motivation",
      "text": "If one were genuinely more common across the sky, that would be a fact about the universe.",
      "word_count": 17,
      "raw_file": "audio_v3/raw/i02-bb7060d2c472.mp3",
      "raw_file_sha256": "f04f04946fbaeb52280fedd438ee095b705d1804dee5da7181014113b9551e67",
      "decoded_file": "audio_v3/decoded/i02.wav",
      "decoded_file_sha256": "141d388841b229180db01d7094e4a6d752a5293987534c8fae1dcb4e60da9301",
      "audio_start_sample": 188064,
      "audio_end_sample": 416160,
      "audio_start_seconds": 3.918,
      "audio_end_seconds": 8.67,
      "visual_action_start_frame": 118,
      "visual_action_start_seconds": 3.933333333333333,
      "alignment_delta_seconds": 0.015333333333332977,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75
    },
    {
      "id": "i03",
      "section": "motivation",
      "text": "But humans sorted the images, so an apparent excess could instead be a fact about the sorters.",
      "word_count": 17,
      "raw_file": "audio_v3/raw/i03-d14fd6ddee00.mp3",
      "raw_file_sha256": "e8c102d15dbf5223b684f01c7a8331a496f42422cfd4186066c33235c63a1fbf",
      "decoded_file": "audio_v3/decoded/i03.wav",
      "decoded_file_sha256": "2234f512af391ee20a9dd4d9aea506f2e18a740595824235ba34946f0d77ffde",
      "audio_start_sample": 452160,
      "audio_end_sample": 724032,
      "audio_start_seconds": 9.42,
      "audio_end_seconds": 15.084,
      "visual_action_start_frame": 283,
      "visual_action_start_seconds": 9.433333333333334,
      "alignment_delta_seconds": 0.013333333333333641,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75
    },
    {
      "id": "i04",
      "section": "motivation",
      "text": "How do we tell the two apart?",
      "word_count": 7,
      "raw_file": "audio_v3/raw/i04-1c9b5c18fd95.mp3",
      "raw_file_sha256": "462204f5fa317804a3c445d9670e458804bd484b0193a4d6a8afcc6e8e7df85d",
      "decoded_file": "audio_v3/decoded/i04.wav",
      "decoded_file_sha256": "7b99c1915631ee0186143cf42e60acd30b6e299c529de5fca46bd5c9c0a97d90",
      "audio_start_sample": 760032,
      "audio_end_sample": 862560,
      "audio_start_seconds": 15.834,
      "audio_end_seconds": 17.97,
      "visual_action_start_frame": 475,
      "visual_action_start_seconds": 15.833333333333334,
      "alignment_delta_seconds": -0.0006666666666657051,
      "pause_after_samples": 177076,
      "pause_after_seconds": 3.6890833333333335
    },
    {
      "id": "s02",
      "section": "question",
      "text": "Can an apparent imbalance between clockwise and anticlockwise labels be separated from one introduced by the labeling process?",
      "word_count": 18,
      "raw_file": "audio_v3/raw/s02-ee829c9ef24e.mp3",
      "raw_file_sha256": "e2b59324949b0472a4d727fdfdc28602f4609cee7fcf739e5d098a48969df74b",
      "decoded_file": "audio_v3/decoded/s02.wav",
      "decoded_file_sha256": "311393dd7c4b0a94d07b452810469d23ce00558007157acc2db972c304d49514",
      "audio_start_sample": 1039636,
      "audio_end_sample": 1328788,
      "audio_start_seconds": 21.659083333333335,
      "audio_end_seconds": 27.683083333333332,
      "visual_action_start_frame": 650,
      "visual_action_start_seconds": 21.666666666666668,
      "alignment_delta_seconds": 0.007583333333332831,
      "pause_after_samples": 177076,
      "pause_after_seconds": 3.6890833333333335
    },
    {
      "id": "s03",
      "section": "two-worlds",
      "text": "Two explanations can create the same apparent imbalance.",
      "word_count": 8,
      "raw_file": "audio_v3/raw/s03-2654139c78f3.mp3",
      "raw_file_sha256": "2794f04f63545e44e7cd0c261ac2a18e7750f380563f59675ea67798853e5421",
      "decoded_file": "audio_v3/decoded/s03.wav",
      "decoded_file_sha256": "3fc018dcc36d9e56d65e98fc3f740e2dfe8f5c13299abbb9a025653cb4f7e0de",
      "audio_start_sample": 1505864,
      "audio_end_sample": 1669448,
      "audio_start_seconds": 31.372166666666665,
      "audio_end_seconds": 34.780166666666666,
      "visual_action_start_frame": 941,
      "visual_action_start_seconds": 31.366666666666667,
      "alignment_delta_seconds": -0.00549999999999784,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75
    },
    {
      "id": "s04",
      "section": "two-worlds",
      "text": "One places the pattern in the images.",
      "word_count": 7,
      "raw_file": "audio_v3/raw/s04-c2f6b0727d04.mp3",
      "raw_file_sha256": "15d8873bf6de434632e25e40ccde5accb6766f65e1ff7bb88f91fa98706c2b4a",
      "decoded_file": "audio_v3/decoded/s04.wav",
      "decoded_file_sha256": "e90da0dd1db7120f8f34f20347f53a0ce1b7550f275d024e01fb04cdcc84f75a",
      "audio_start_sample": 1705448,
      "audio_end_sample": 1821800,
      "audio_start_seconds": 35.530166666666666,
      "audio_end_seconds": 37.954166666666666,
      "visual_action_start_frame": 1066,
      "visual_action_start_seconds": 35.53333333333333,
      "alignment_delta_seconds": 0.0031666666666652077,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75
    },
    {
      "id": "s05",
      "section": "two-worlds",
      "text": "The other places it in the labeling process.",
      "word_count": 8,
      "raw_file": "audio_v3/raw/s05-798294462935.mp3",
      "raw_file_sha256": "62b35803b97f5b779dc24a95a073cfa57d716641460ac7a4e0d1002ef072370a",
      "decoded_file": "audio_v3/decoded/s05.wav",
      "decoded_file_sha256": "98eed9aacffb4a885b74f8da9b1981a2fbdb95bc49e5b2483f4f64369fc5f1e9",
      "audio_start_sample": 1857800,
      "audio_end_sample": 2032904,
      "audio_start_seconds": 38.704166666666666,
      "audio_end_seconds": 42.35216666666667,
      "visual_action_start_frame": 1161,
      "visual_action_start_seconds": 38.7,
      "alignment_delta_seconds": -0.004166666666662877,
      "pause_after_samples": 177076,
      "pause_after_seconds": 3.6890833333333335
    },
    {
      "id": "s06",
      "section": "mirror-climax",
      "text": "Apply one decisive test to both worlds: mirror the same conceptual spiral horizontally.",
      "word_count": 13,
      "raw_file": "audio_v3/raw/s06-ddb7198d6964.mp3",
      "raw_file_sha256": "a36fcdf270fe3916f2c2e205b33ccd2100f3c6053aae8bc328e90978f4ad870c",
      "decoded_file": "audio_v3/decoded/s06.wav",
      "decoded_file_sha256": "ab6fd1d84d885827956eae00fa91a638cf39cb75b2b0f49c9d1cdc2d858d2cf8",
      "audio_start_sample": 2209980,
      "audio_end_sample": 2463420,
      "audio_start_seconds": 46.04125,
      "audio_end_seconds": 51.32125,
      "visual_action_start_frame": 1381,
      "visual_action_start_seconds": 46.03333333333333,
      "alignment_delta_seconds": -0.007916666666666572,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75
    },
    {
      "id": "s07",
      "section": "mirror-climax",
      "text": "The geometry reverses, and its apparent label inverts from clockwise to anticlockwise.",
      "word_count": 12,
      "raw_file": "audio_v3/raw/s07-4ec7573b3247.mp3",
      "raw_file_sha256": "a48b0bce294c06c3124fd19346cee1ad99351889e0f78ab25d2ce833e8d4d83e",
      "decoded_file": "audio_v3/decoded/s07.wav",
      "decoded_file_sha256": "1c443f7886acea4b8b76e3b59852206865cbb178db8ce77b2886c01cdc8af7f8",
      "audio_start_sample": 2499420,
      "audio_end_sample": 2737884,
      "audio_start_seconds": 52.07125,
      "audio_end_seconds": 57.03925,
      "visual_action_start_frame": 1562,
      "visual_action_start_seconds": 52.06666666666667,
      "alignment_delta_seconds": -0.004583333333329165,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75
    },
    {
      "id": "s08",
      "section": "mirror-climax",
      "text": "If the pattern belongs to the images themselves, it must follow that inversion.",
      "word_count": 13,
      "raw_file": "audio_v3/raw/s08-b7adc8ea224c.mp3",
      "raw_file_sha256": "e4ad459f0b055044439a524f3e0679259e0d09b9cad07852e8ccbdb8cc3b07cd",
      "decoded_file": "audio_v3/decoded/s08.wav",
      "decoded_file_sha256": "db75a04e7aea4b5dabc10055222d1a2fb1d6c2cf45ef4d26062b6f2e232c7271",
      "audio_start_sample": 2773884,
      "audio_end_sample": 2975484,
      "audio_start_seconds": 57.78925,
      "audio_end_seconds": 61.98925,
      "visual_action_start_frame": 1734,
      "visual_action_start_seconds": 57.8,
      "alignment_delta_seconds": 0.010749999999994486,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75
    },
    {
      "id": "s09",
      "section": "mirror-climax",
      "text": "If it entered through the labeling process instead, it need not follow the pixels.",
      "word_count": 14,
      "raw_file": "audio_v3/raw/s09-0de62cff2934.mp3",
      "raw_file_sha256": "99c9d3c1a4772ae851931b12ac377cd7786d1deb0173e69721c53ab7e138fa74",
      "decoded_file": "audio_v3/decoded/s09.wav",
      "decoded_file_sha256": "b70575fe2d961a097bf5e846d5fe395e7a484cbe53168064041f286acd585321",
      "audio_start_sample": 3011484,
      "audio_end_sample": 3260316,
      "audio_start_seconds": 62.73925,
      "audio_end_seconds": 67.92325,
      "visual_action_start_frame": 1882,
      "visual_action_start_seconds": 62.733333333333334,
      "alignment_delta_seconds": -0.005916666666664128,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75
    },
    {
      "id": "s10",
      "section": "mirror-climax",
      "text": "One mirror, two incompatible predicted behaviors: that difference is the scientific discriminant.",
      "word_count": 12,
      "raw_file": "audio_v3/raw/s10-3b19d3104719.mp3",
      "raw_file_sha256": "0eeab624a2b0f25d0ff5e86465ccac5ebe3b0ba9d849a1745d28bed596cd03b4",
      "decoded_file": "audio_v3/decoded/s10.wav",
      "decoded_file_sha256": "12cceab4ba11a0ee8b262f0bc940171998cd2084ec056a223ee61f39bd68dcf3",
      "audio_start_sample": 3296316,
      "audio_end_sample": 3575100,
      "audio_start_seconds": 68.67325,
      "audio_end_seconds": 74.48125,
      "visual_action_start_frame": 2060,
      "visual_action_start_seconds": 68.66666666666667,
      "alignment_delta_seconds": -0.006583333333324504,
      "pause_after_samples": 177076,
      "pause_after_seconds": 3.6890833333333335
    },
    {
      "id": "s11",
      "section": "discipline",
      "text": "Before any number was computed, we fixed the mirror logic, every cut, both thresholds, and paired comparisons.",
      "word_count": 17,
      "raw_file": "audio_v3/raw/s11-1d072584576a.mp3",
      "raw_file_sha256": "243c0eabd055c0a227296ae181ad93dc54a8504f7372b4dd8a481bf16c081e1a",
      "decoded_file": "audio_v3/decoded/s11.wav",
      "decoded_file_sha256": "e0cf5fa677044bb4de68b6ce56aa1d9770258935a5a48841fdcfc2618b751f90",
      "audio_start_sample": 3752176,
      "audio_end_sample": 4059760,
      "audio_start_seconds": 78.17033333333333,
      "audio_end_seconds": 84.57833333333333,
      "visual_action_start_frame": 2345,
      "visual_action_start_seconds": 78.16666666666667,
      "alignment_delta_seconds": -0.0036666666666604897,
      "pause_after_samples": 177075,
      "pause_after_seconds": 3.6890625
    },
    {
      "id": "s12",
      "section": "funnel",
      "text": "The frozen Galaxy Zoo 1 source contains 667,944 rows.",
      "word_count": 10,
      "raw_file": "audio_v3/raw/s12-390ca91eca91.mp3",
      "raw_file_sha256": "cf34c13b8e2881e984a0241a43f5bd290d86b546960457f87637d9e7336a5288",
      "decoded_file": "audio_v3/decoded/s12.wav",
      "decoded_file_sha256": "9c409e4cf8b732c5d4495eb545d5cdcc30b9aa5c5f7b3241c084344ee2298363",
      "audio_start_sample": 4236835,
      "audio_end_sample": 4540963,
      "audio_start_seconds": 88.26739583333334,
      "audio_end_seconds": 94.60339583333334,
