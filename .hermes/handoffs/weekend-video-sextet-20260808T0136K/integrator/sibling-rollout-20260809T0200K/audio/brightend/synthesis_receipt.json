        }
      }
    },
    {
      "id": "x01",
      "section": "payoff",
      "text": "Ask the opening question again: are object records genuinely absent, or were they invisible to the retrieval instrument?",
      "text_sha256": "aeb57671b6ed688d0abb5bc857ecb4f6027f81663189561dbfee6a1a09e41711",
      "file": "audio/brightend/raw/x01-aeb57671b6ed.mp3",
