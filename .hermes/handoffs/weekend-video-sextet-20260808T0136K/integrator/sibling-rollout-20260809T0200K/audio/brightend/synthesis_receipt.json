            "sample_rate": "24000",
            "channels": 1
          }
        ],
        "format": {
          "duration": "7.824000",
          "size": "125184"
        }
      }
    },
    {
      "id": "b01",
      "section": "boundary",
      "text": "What is known is the retrieval and eligibility design; catalogue totals, object counts, an archival gap, and any luminosity-function pace remain outside this canary.",
      "text_sha256": "4dad6a0bf05c08a7bcdf7fc5581366bdbe6d13e913a11af9a9ab1e0bb0f994c1",
      "file": "audio/brightend/raw/b01-4dad6a0bf05c.mp3",
