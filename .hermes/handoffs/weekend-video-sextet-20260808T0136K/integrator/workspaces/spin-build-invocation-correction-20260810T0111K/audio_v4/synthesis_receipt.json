            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "4.968000",
          "size": "79488"
        }
      }
    },
    {
      "id": "s15",
      "section": "equation",
      "text": "Their difference is the numerator, and their total is the denominator.",
      "text_sha256": "b20390383d0f8833dcc0897c2ad3413d02cb085a4fb126d88bace89286ac33d9",
      "file": "audio_v4/raw/s15-b20390383d0f.mp3",
