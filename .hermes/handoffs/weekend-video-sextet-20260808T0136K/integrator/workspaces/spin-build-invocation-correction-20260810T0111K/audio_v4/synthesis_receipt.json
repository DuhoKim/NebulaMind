            "sample_rate": "24000",
            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "5.616000",
          "size": "89856"
        }
      }
    },
    {
      "id": "s11",
      "section": "discipline",
      "text": "Before any number was computed, we fixed the mirror logic, every cut, both thresholds, and paired comparisons.",
      "text_sha256": "1d072584576a41abdbe2a591b174a1a08f23bdd5822277e879e304f093bf8cb8",
      "file": "audio_v4/raw/s11-1d072584576a.mp3",
