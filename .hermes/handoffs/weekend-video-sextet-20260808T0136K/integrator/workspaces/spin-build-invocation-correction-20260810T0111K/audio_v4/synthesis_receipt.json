            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "4.128000",
          "size": "66048"
        }
      }
    },
    {
      "id": "s16",
      "section": "equation",
      "text": "The sign would indicate which label is more numerous, but the predeclared asymmetry value remains withheld.",
      "text_sha256": "57707812688af028a78555ef740297572ebcfdeacf3015ce1fdf05ad82a7f970",
      "file": "audio_v4/raw/s16-57707812688a.mp3",
