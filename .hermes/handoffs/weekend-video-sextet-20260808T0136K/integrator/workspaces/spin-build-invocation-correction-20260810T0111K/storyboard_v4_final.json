  "records": [
    {
      "id": "i01",
      "section": "motivation",
      "text": "On the largest scales, cosmology expects the universe to look the same in every direction.",
      "word_count": 15,
      "raw_file": "audio_v4/raw/i01-50b6c1cb04f9.mp3",
      "raw_file_sha256": "f1ccabd79ef5e2e3218811096e56583d80754c142dcea6d180566cd580899de1",
      "decoded_file": "audio_v4/decoded/i01.wav",
      "decoded_file_sha256": "8c04ac157714c0df34eb1cbaf21d9305d9ebe9be8ffca7c26eb21414ec4b0f78",
      "audio_start_sample": 28800,
      "audio_end_sample": 293760,
      "audio_start_seconds": 0.6,
      "audio_end_seconds": 6.12,
      "visual_action_start_frame": 18,
      "visual_action_start_seconds": 0.6,
      "alignment_delta_seconds": 0.0,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75,
      "beat": "expectation",
      "visual_action": "A conceptual all-sky field assembles from equal, unselected clockwise and anticlockwise spiral glyphs around a neutral sphere; the frame is labelled expectation, not data.",
      "display_citation": "Cosmological principle \u00b7 isotropy expectation",
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "i02",
      "section": "motivation",
      "text": "A conceptual sky of spiral galaxies should therefore show no built-in preference for clockwise or anticlockwise winding.",
      "word_count": 17,
      "raw_file": "audio_v4/raw/i02-db0be38e5a64.mp3",
      "raw_file_sha256": "ad3d68680a935ba16cd8303518c9db8fda13d0a1fe674542bbd410fc79d7932e",
      "decoded_file": "audio_v4/decoded/i02.wav",
      "decoded_file_sha256": "15ad5061fa19cc057ac45965eddcdab309a327062f06738594b3076b03d39a4e",
      "audio_start_sample": 329760,
      "audio_end_sample": 633888,
      "audio_start_seconds": 6.87,
      "audio_end_seconds": 13.206,
      "visual_action_start_frame": 206,
      "visual_action_start_seconds": 6.866666666666666,
      "alignment_delta_seconds": -0.0033333333333338544,
      "pause_after_samples": 157881,
      "pause_after_seconds": 3.2891875,
      "beat": "expectation",
      "visual_action": "The conceptual sky rotates while paired handedness glyphs remain balanced across every sector; no count, axis, or direction is selected.",
      "display_citation": "Expectation under isotropy \u00b7 conceptual, not observed",
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "i03",
      "section": "motivation",
      "text": "Galaxies acquire angular momentum while surrounding structure grows, so balance is the prediction, not an accident.",
      "word_count": 16,
      "raw_file": "audio_v4/raw/i03-7b63a9b9c192.mp3",
      "raw_file_sha256": "8e4e91d1b9fd6a8967c484c12ff82b0c575f35ef80070e884718276715c3487d",
      "decoded_file": "audio_v4/decoded/i03.wav",
      "decoded_file_sha256": "92c906f41a27ef00ead6c6aba6fbddf8e46715be011586b08a0a323e0ec86ed5",
      "audio_start_sample": 791769,
      "audio_end_sample": 1079769,
      "audio_start_seconds": 16.4951875,
      "audio_end_seconds": 22.4951875,
      "visual_action_start_frame": 495,
      "visual_action_start_seconds": 16.5,
      "alignment_delta_seconds": 0.004812499999999886,
      "pause_after_samples": 157881,
      "pause_after_seconds": 3.2891875,
      "beat": "tidal-torque",
      "visual_action": "A proto-galaxy and surrounding mass nodes exchange symmetric gravitational-torque arrows, then resolve into two equally weighted possible spin glyphs.",
      "display_citation": "White 1984 \u00b7 angular-momentum growth in protogalaxies",
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "i04",
      "section": "motivation",
      "text": "A preference for spiral galaxies in one sector of the sky to be left-handed or right-handed spirals would indicate a parity violating asymmetry in the overall universe and a preferred axis.",
      "word_count": 31,
      "raw_file": "audio_v4/raw/i04-2e44c9feaac7.mp3",
      "raw_file_sha256": "f08c103a12014f68f3e4ecc44587fc5555352fd5cc591edf1b3ffb1388250933",
      "decoded_file": "audio_v4/decoded/i04.wav",
      "decoded_file_sha256": "9ba8ed4df7e7d83de387a05acc7d53408b06006c62ae9716528f2f9fa5130c00",
      "audio_start_sample": 1237650,
      "audio_end_sample": 1728402,
      "audio_start_seconds": 25.784375,
      "audio_end_seconds": 36.008375,
      "visual_action_start_frame": 774,
      "visual_action_start_seconds": 25.8,
      "alignment_delta_seconds": 0.015625,
      "pause_after_samples": 157881,
      "pause_after_seconds": 3.2891875,
      "beat": "conditional-stakes",
      "visual_action": "A clearly hypothetical IF panel links a generic handedness-preference token to mirror-symmetry and preferred-axis question marks; no direction, sky sector, or outcome is chosen.",
      "display_citation": "Longo 2011 \u00b7 verbatim abstract \u00b7 conditional",
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "i05",
      "section": "motivation",
      "text": "For decades, that question has been claimed, challenged, and left unsettled; this video adopts no answer.",
      "word_count": 16,
      "raw_file": "audio_v4/raw/i05-28e9200e7f82.mp3",
      "raw_file_sha256": "981eb7bb56df87c731c38fd9decac1610ef49ff303c486514165497f2f29866b",
      "decoded_file": "audio_v4/decoded/i05.wav",
      "decoded_file_sha256": "442de8dc8bbabd7618e88a481f3087befb206fe389718601d69c2d2bc8e7ad4f",
      "audio_start_sample": 1886283,
      "audio_end_sample": 2209995,
      "audio_start_seconds": 39.2975625,
      "audio_end_seconds": 46.0415625,
      "visual_action_start_frame": 1179,
      "visual_action_start_seconds": 39.3,
      "alignment_delta_seconds": 0.002437499999999204,
      "pause_after_samples": 157881,
      "pause_after_seconds": 3.2891875,
      "beat": "open-question",
      "visual_action": "Equal-weight literature cards labelled claims and challenges arrive from opposite sides and stop at one central open-question node, without a winner or result geometry.",
      "display_citation": "Land et al. 2008 \u00b7 Longo 2011 \u00b7 contested question",
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "i06",
      "section": "motivation",
      "text": "The catch is that people and algorithms can carry a left-right sorting bias, so the same images need a mirror control.",
      "word_count": 21,
      "raw_file": "audio_v4/raw/i06-b6ba11c74ba5.mp3",
      "raw_file_sha256": "f19709fe84aaa18a1156eb4149e100407521d6cf144a11e87251dc07334de44c",
      "decoded_file": "audio_v4/decoded/i06.wav",
      "decoded_file_sha256": "c303d038e9689917857683cbbf756cf9c781c463083c84ba28e2aab0b3102f53",
      "audio_start_sample": 2367876,
      "audio_end_sample": 2680068,
      "audio_start_seconds": 49.33075,
      "audio_end_seconds": 55.83475,
      "visual_action_start_frame": 1480,
      "visual_action_start_seconds": 49.333333333333336,
      "alignment_delta_seconds": 0.002583333333333826,
      "pause_after_samples": 157881,
      "pause_after_seconds": 3.2891875,
      "beat": "catch-and-handoff",
      "visual_action": "A single conceptual galaxy image passes through human and algorithm labeling nodes, then moves toward a horizontal mirror plane that hands off to the existing method spine.",
      "display_citation": "Land et al. 2008 \u00b7 handedness classification bias",
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s02",
      "section": "question",
      "text": "Can an apparent imbalance between clockwise and anticlockwise labels be separated from one introduced by the labeling process?",
      "word_count": 18,
      "raw_file": "audio_v4/raw/s02-ee829c9ef24e.mp3",
      "raw_file_sha256": "0e7dddf5260e1e79572b78c9cd9ef7c528dbf782072ccbbd81270fac88b0fdff",
      "decoded_file": "audio_v4/decoded/s02.wav",
      "decoded_file_sha256": "8af54846019dc6dfd61e59b9a7937ebab307b9260ff58f3ea7b28d9f709d8d4c",
      "audio_start_sample": 2837949,
      "audio_end_sample": 3161661,
      "audio_start_seconds": 59.1239375,
      "audio_end_seconds": 65.8679375,
      "visual_action_start_frame": 1774,
      "visual_action_start_seconds": 59.13333333333333,
      "alignment_delta_seconds": 0.009395833333336157,
      "pause_after_samples": 157881,
      "pause_after_seconds": 3.2891875,
      "beat": null,
      "visual_action": "The technical question spans two equal, unresolved explanation lanes after the broad why-study introduction.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s03",
      "section": "two-worlds",
      "text": "Two explanations can create the same apparent imbalance.",
      "word_count": 8,
      "raw_file": "audio_v4/raw/s03-2654139c78f3.mp3",
      "raw_file_sha256": "a5f24e69ed0e14a4ea2ac15559c0ffb56fdeb8d967ab95f456ce3e7f2acffb9d",
      "decoded_file": "audio_v4/decoded/s03.wav",
      "decoded_file_sha256": "5143883bdafacdd3cd13827beb0da05658e99d752476a6cb9deecebaad8a9ff1",
      "audio_start_sample": 3319542,
      "audio_end_sample": 3485430,
      "audio_start_seconds": 69.157125,
      "audio_end_seconds": 72.613125,
      "visual_action_start_frame": 2075,
      "visual_action_start_seconds": 69.16666666666667,
      "alignment_delta_seconds": 0.009541666666677884,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75,
      "beat": null,
      "visual_action": "Two explanation nodes feed the same unresolved count symbol.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s04",
      "section": "two-worlds",
      "text": "One places the pattern in the images.",
      "word_count": 7,
      "raw_file": "audio_v4/raw/s04-c2f6b0727d04.mp3",
      "raw_file_sha256": "ce23c7acfa745042fc5978794fe3d6f57cb796c018781d73e52478ccbdd55090",
      "decoded_file": "audio_v4/decoded/s04.wav",
      "decoded_file_sha256": "c24a9b3f789a061cc3d15bb39ea236cb288f294480adf46e40728067d277e712",
      "audio_start_sample": 3521430,
      "audio_end_sample": 3656214,
      "audio_start_seconds": 73.363125,
      "audio_end_seconds": 76.171125,
      "visual_action_start_frame": 2201,
      "visual_action_start_seconds": 73.36666666666666,
      "alignment_delta_seconds": 0.0035416666666634455,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75,
      "beat": null,
      "visual_action": "The IMAGE-LINKED lane illuminates around a spiral image.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s05",
      "section": "two-worlds",
      "text": "The other places it in the labeling process.",
      "word_count": 8,
      "raw_file": "audio_v4/raw/s05-798294462935.mp3",
      "raw_file_sha256": "e3c4cba9ea288a689a94001b530d5c504aff4a92881469fc5c25fdb07bb1f4cf",
      "decoded_file": "audio_v4/decoded/s05.wav",
      "decoded_file_sha256": "5c879c218df300ca148c49ba6f26356dc9fad874c18e04a55642047fa19c988c",
      "audio_start_sample": 3692214,
      "audio_end_sample": 3792438,
      "audio_start_seconds": 76.921125,
      "audio_end_seconds": 79.009125,
      "visual_action_start_frame": 2308,
      "visual_action_start_seconds": 76.93333333333334,
      "alignment_delta_seconds": 0.012208333333333599,
      "pause_after_samples": 157881,
      "pause_after_seconds": 3.2891875,
      "beat": null,
      "visual_action": "The LABELING-PROCESS lane illuminates around a human-labeling node.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s06",
      "section": "mirror-climax",
      "text": "Apply one decisive test to both worlds: mirror the same conceptual spiral horizontally.",
      "word_count": 13,
      "raw_file": "audio_v4/raw/s06-ddb7198d6964.mp3",
      "raw_file_sha256": "977115cd83a32f073e69ea522be5666c7d23701e8a80448ddc75a5753438a85b",
      "decoded_file": "audio_v4/decoded/s06.wav",
      "decoded_file_sha256": "2283ff7b99e418f6e6f7b3caacddbc29e99f23990713acb98ec39f9f50baa5ac",
      "audio_start_sample": 3950319,
      "audio_end_sample": 4223343,
      "audio_start_seconds": 82.2983125,
      "audio_end_seconds": 87.9863125,
      "visual_action_start_frame": 2469,
      "visual_action_start_seconds": 82.3,
      "alignment_delta_seconds": 0.0016875000000027285,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75,
      "beat": null,
      "visual_action": "One conceptual spiral moves to a vertical mirror plane and begins a continuous horizontal flip.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s07",
      "section": "mirror-climax",
      "text": "The geometry reverses, and its apparent label inverts from clockwise to anticlockwise.",
      "word_count": 12,
      "raw_file": "audio_v4/raw/s07-4ec7573b3247.mp3",
      "raw_file_sha256": "f28fed88b5a4c2b1b5bb895476c18a6cb96394c3cc0a3c033ca2adb8c5d34d8c",
      "decoded_file": "audio_v4/decoded/s07.wav",
      "decoded_file_sha256": "95d96be2b3bdacd121534fa6fc0f1bcad3423bbf425cc17d3331dbe340fa6270",
      "audio_start_sample": 4259343,
      "audio_end_sample": 4486287,
      "audio_start_seconds": 88.7363125,
      "audio_end_seconds": 93.4643125,
      "visual_action_start_frame": 2662,
      "visual_action_start_seconds": 88.73333333333333,
      "alignment_delta_seconds": -0.002979166666662536,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75,
      "beat": null,
      "visual_action": "The same spiral completes its horizontal inversion while the label morphs from clockwise to anticlockwise.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s08",
      "section": "mirror-climax",
      "text": "If the pattern belongs to the images themselves, it must follow that inversion.",
      "word_count": 13,
      "raw_file": "audio_v4/raw/s08-b7adc8ea224c.mp3",
      "raw_file_sha256": "850eaa5915bb52a7100022bc2cd69ec6aa4d2b1e5b71f8ae40089e1bb892211d",
      "decoded_file": "audio_v4/decoded/s08.wav",
      "decoded_file_sha256": "8379f9732d61ea8877a7b36c7608fc4b26c3db3810c174919c34c6d82c5994f5",
      "audio_start_sample": 4522287,
      "audio_end_sample": 4728495,
      "audio_start_seconds": 94.2143125,
      "audio_end_seconds": 98.5103125,
      "visual_action_start_frame": 2826,
      "visual_action_start_seconds": 94.2,
      "alignment_delta_seconds": -0.014312500000002615,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75,
      "beat": null,
      "visual_action": "The image-linked prediction arrow follows the inverted geometry and pulses MUST INVERT.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s09",
      "section": "mirror-climax",
      "text": "If it entered through the labeling process instead, it need not follow the pixels.",
      "word_count": 14,
      "raw_file": "audio_v4/raw/s09-0de62cff2934.mp3",
      "raw_file_sha256": "d9151326d268bad5f786360b0251d3b3d2ace23ee5cad90380d8441328de0b9e",
      "decoded_file": "audio_v4/decoded/s09.wav",
      "decoded_file_sha256": "bd85ea93cf0783ffc21be6709f9011c405da599e6c74d01f5a82cefbcf18a3e4",
      "audio_start_sample": 4764495,
      "audio_end_sample": 4989135,
      "audio_start_seconds": 99.2603125,
      "audio_end_seconds": 103.9403125,
      "visual_action_start_frame": 2978,
      "visual_action_start_seconds": 99.26666666666667,
      "alignment_delta_seconds": 0.006354166666667993,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75,
      "beat": null,
      "visual_action": "The labeling-process prediction separates from the pixel transform and pulses NEED NOT INVERT.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s10",
      "section": "mirror-climax",
      "text": "One mirror, two incompatible predicted behaviors: that difference is the scientific discriminant.",
      "word_count": 12,
      "raw_file": "audio_v4/raw/s10-3b19d3104719.mp3",
      "raw_file_sha256": "5222858e0d5ecf270659ea51ca941aea6bc5c50d870084602373270bc1743b45",
      "decoded_file": "audio_v4/decoded/s10.wav",
      "decoded_file_sha256": "35e9e2d006a8fbaf6c259da91b9529f7f7e16d326a5d795a182b68b4fbe30542",
      "audio_start_sample": 5025135,
      "audio_end_sample": 5294703,
      "audio_start_seconds": 104.6903125,
      "audio_end_seconds": 110.3063125,
      "visual_action_start_frame": 3141,
      "visual_action_start_seconds": 104.7,
      "alignment_delta_seconds": 0.009687499999998295,
      "pause_after_samples": 157881,
      "pause_after_seconds": 3.2891875,
      "beat": null,
      "visual_action": "The two prediction lanes lock into one MIRROR DISCRIMINANT diagram, the visual and spoken peak.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s11",
      "section": "discipline",
      "text": "Before any number was computed, we fixed the mirror logic, every cut, both thresholds, and paired comparisons.",
      "word_count": 17,
      "raw_file": "audio_v4/raw/s11-1d072584576a.mp3",
      "raw_file_sha256": "ba74959fa22eaefdce2ac5c4edf8e2bcb10ace4100df50fe2a588187c6e2ff00",
      "decoded_file": "audio_v4/decoded/s11.wav",
      "decoded_file_sha256": "a0b66b1584590ddc8b2ccfb442080f4ec76aaaacea34930cf3aa77e8d7d49364",
      "audio_start_sample": 5452584,
      "audio_end_sample": 5764776,
      "audio_start_seconds": 113.5955,
      "audio_end_seconds": 120.0995,
      "visual_action_start_frame": 3408,
      "visual_action_start_seconds": 113.6,
      "alignment_delta_seconds": 0.004499999999993065,
      "pause_after_samples": 157881,
      "pause_after_seconds": 3.2891875,
      "beat": null,
      "visual_action": "A pre-registration bracket closes around MIRROR, CUTS, THRESHOLDS, and PAIRED COMPARISON.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s12",
      "section": "funnel",
      "text": "The frozen Galaxy Zoo 1 source contains 667,944 rows.",
      "word_count": 10,
      "raw_file": "audio_v4/raw/s12-390ca91eca91.mp3",
      "raw_file_sha256": "691ade06125f9047b49d7eb59420c8c4162613686c9c3e78983f2df1e09b250e",
      "decoded_file": "audio_v4/decoded/s12.wav",
      "decoded_file_sha256": "f451e242fa4137eeb430b28c826a8cba2d49c4e9c0ceca022d7ae454c08ca434",
      "audio_start_sample": 5922657,
      "audio_end_sample": 6248673,
      "audio_start_seconds": 123.3886875,
      "audio_end_seconds": 130.1806875,
      "visual_action_start_frame": 3702,
      "visual_action_start_seconds": 123.4,
      "alignment_delta_seconds": 0.011312500000002501,
      "pause_after_samples": 36000,
      "pause_after_seconds": 0.75,
      "beat": null,
      "visual_action": "Row particles stream into a Galaxy Zoo 1 data release, Table 2 reservoir with the sample size attached.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s13",
      "section": "funnel",
      "text": "Three parallel readouts apply the spiral flag and two frozen thresholds; exact counts stay attached to their branches.",
      "word_count": 18,
      "raw_file": "audio_v4/raw/s13-1a27c2ca9817.mp3",
      "raw_file_sha256": "014e6bbd230189fd8902f36957587967efe4a90d326e19e7e932caddee71863b",
      "decoded_file": "audio_v4/decoded/s13.wav",
      "decoded_file_sha256": "54586ea615eaa458db2dc2f4aa02095068633a0b338ac5d97b343471c9b7a192",
      "audio_start_sample": 6284673,
      "audio_end_sample": 6618753,
      "audio_start_seconds": 130.9306875,
      "audio_end_seconds": 137.8906875,
      "visual_action_start_frame": 3928,
      "visual_action_start_seconds": 130.93333333333334,
      "alignment_delta_seconds": 0.002645833333332348,
      "pause_after_samples": 157881,
      "pause_after_seconds": 3.2891875,
      "beat": null,
      "visual_action": "The source splits into three parallel branches; each labeled stage reveals its exact row count.",
      "display_citation": null,
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "s14",
      "section": "equation",
      "text": "Within one readout, N C W and N A C W count the labels.",
      "word_count": 14,
      "raw_file": "audio_v4/raw/s14-fedecb328ae8.mp3",
      "raw_file_sha256": "c4c83544c36ebc95bb639d7f722a8316c569b240a3fa17acd192f4a6ed5554b6",
      "decoded_file": "audio_v4/decoded/s14.wav",
      "decoded_file_sha256": "01004d2bf6101b256dd159979f0d5e59ad4bdadce196ae814c69412b9d41292f",
      "audio_start_sample": 6776634,
