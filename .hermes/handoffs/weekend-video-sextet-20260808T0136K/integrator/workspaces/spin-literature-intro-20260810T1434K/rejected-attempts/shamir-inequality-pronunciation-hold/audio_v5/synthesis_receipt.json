        }
      }
    },
    {
      "id": "s21",
      "section": "boundary",
      "text": "Known now are the sample, estimator, mirror logic, and controls; no result value, direction, or interpretation is reportable.",
      "text_sha256": "7356873d828a2463d0664a9d4989791206bc4a7122dbb54cc03770a94b35d338",
      "file": "audio_v5/raw/s21-7356873d828a.mp3",
