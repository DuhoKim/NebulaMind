        }
      }
    },
    {
      "id": "s14",
      "section": "equation",
      "text": "Within one readout, N C W and N A C W count the labels.",
      "text_sha256": "fedecb328ae897c55c366a16a0da597036fc3256806a691b6ad6c2d4252ec6db",
      "file": "audio_v5/raw/s14-fedecb328ae8.mp3",
