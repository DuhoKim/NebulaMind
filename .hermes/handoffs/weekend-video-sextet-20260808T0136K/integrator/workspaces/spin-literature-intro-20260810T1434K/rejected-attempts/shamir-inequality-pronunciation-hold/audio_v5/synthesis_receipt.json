          "duration": "4.848000",
          "size": "77568"
        }
      }
    },
    {
      "id": "s20",
      "section": "discipline-gates",
      "text": "That standard makes the independent post-run verdict the next gate; the stored-direction frame and evidence, receipt, and referee checks must also meet the frozen rules.",
      "text_sha256": "b1363e4835bef25838854da01ac3b8f97248b577b97ac9b72dd6e6d5edf52222",
      "file": "audio_v5/raw/s20-b1363e4835be.mp3",
