          "size": "116736"
        }
      }
    },
    {
      "id": "s19",
      "section": "discipline-gates",
      "text": "We tied our own hands so the answer cannot be shaped by choices made after seeing it.",
      "text_sha256": "b62c1d547b78c95cf8d53a6bfb08de4f3eaeee81f36b21c5275267be95d0b8c7",
      "file": "audio_v5/raw/s19-b62c1d547b78.mp3",
