        }
      }
    },
    {
      "id": "s17",
      "section": "controls",
      "text": "The control matrix joins the mirror, both thresholds, and same-object pairs.",
      "text_sha256": "3d9085cd8f35949fb408e7c0e32a47f572e778549452b93998c64a7e51a3e12f",
      "file": "audio_v5/raw/s17-3d9085cd8f35.mp3",
