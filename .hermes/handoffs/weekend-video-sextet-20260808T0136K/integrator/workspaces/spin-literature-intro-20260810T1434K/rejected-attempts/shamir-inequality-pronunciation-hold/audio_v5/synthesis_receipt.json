          "size": "85248"
        }
      }
    },
    {
      "id": "s18",
      "section": "controls",
      "text": "They test inversion, threshold sensitivity, and individual change versus sample composition; design only.",
      "text_sha256": "4d1afd6be2a80990c2d843e1a5e0b8f76bd7747347ff21c8614937d860e6aef6",
      "file": "audio_v5/raw/s18-4d1afd6be2a8.mp3",
