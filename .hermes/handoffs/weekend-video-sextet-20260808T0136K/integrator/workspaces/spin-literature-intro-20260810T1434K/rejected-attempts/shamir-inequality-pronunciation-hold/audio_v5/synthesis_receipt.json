            "channels": 1,
            "bit_rate": "128000"
          }
        ],
        "format": {
          "duration": "6.576000",
          "size": "105216"
        }
      }
    },
    {
      "id": "s12",
      "section": "funnel",
      "text": "The frozen Galaxy Zoo 1 source contains 667,944 rows.",
      "text_sha256": "390ca91eca91349c7a7bee5406951f9c7229408ff5c9fc6f96e0b94ed88c6b38",
      "file": "audio_v5/raw/s12-390ca91eca91.mp3",
