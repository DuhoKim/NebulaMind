        }
      }
    },
    {
      "id": "s13",
      "section": "funnel",
      "text": "Three parallel readouts apply the spiral flag and two frozen thresholds; exact counts stay attached to their branches.",
      "text_sha256": "1a27c2ca9817d7c82f56ef171e944fbbb83cc51748a9027ea53592d0604b1bcb",
      "file": "audio_v5/raw/s13-1a27c2ca9817.mp3",
