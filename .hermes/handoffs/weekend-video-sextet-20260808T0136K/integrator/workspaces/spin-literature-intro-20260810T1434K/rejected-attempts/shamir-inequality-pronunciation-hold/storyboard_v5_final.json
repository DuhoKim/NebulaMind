      "audio_start_sample": 838388,
      "audio_end_sample": 1162100,
      "audio_start_seconds": 17.466416666666667,
      "audio_end_seconds": 24.210416666666667,
      "visual_action_start_frame": 524,
      "visual_action_start_seconds": 17.466666666666665,
      "alignment_delta_seconds": 0.000249999999997641,
      "pause_after_samples": 196436,
      "pause_after_seconds": 4.092416666666667,
      "beat": "tidal-torque",
      "visual_action": "A proto-galaxy and surrounding mass nodes exchange symmetric gravitational-torque arrows, then resolve into two equally weighted possible spin glyphs.",
      "display_citation": "White 1984 \u00b7 angular-momentum growth in protogalaxies",
      "timing_status": "PCM_DERIVED_FINAL"
    },
    {
      "id": "i04",
      "section": "motivation",
      "text": "A preference for spiral galaxies in one sector of the sky to be left-handed or right-handed spirals would indicate a parity violating asymmetry in the overall universe and a preferred axis.",
      "word_count": 31,
      "raw_file": "audio_v5/raw/i04-2e44c9feaac7.mp3",
      "raw_file_sha256": "fa94f8db4e837d8d1c6dacd98fd858e3ec76130875bf61cb674a9d651cc94c04",
      "decoded_file": "audio_v5/decoded/i04.wav",
      "decoded_file_sha256": "848806795a5f7d343d434a0cb005572ebca86b2f9e7eeab3869f8a4bb2ee9be3",
      "audio_start_sample": 1358536,
      "audio_end_sample": 1851592,
      "audio_start_seconds": 28.302833333333332,
      "audio_end_seconds": 38.57483333333333,
